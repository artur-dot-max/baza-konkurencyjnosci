# Baza danych. Docker Compose buduje własny DATABASE_URL z wartości POSTGRES_*.
DATABASE_URL=postgresql://postgres:change-me-local-password@127.0.0.1:5432/baza_konkurencyjnosci?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-password
POSTGRES_DB=baza_konkurencyjnosci

# Uwierzytelnianie. Wygeneruj niezależne sekrety, np. przez: openssl rand -base64 48
AUTH_SECRET=change-me-generate-a-random-auth-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Baza Konkurencyjności Funduszu Sprawiedliwości

# Pliki i ograniczenia żądań
UPLOAD_DIR=.local/uploads
MAX_FILE_SIZE_MB=10
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Poczta. Puste wartości wyłączają rzeczywistą wysyłkę.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_EMAIL=

# Wywołania wewnętrzne workera. Musi różnić się od AUTH_SECRET.
CRON_SECRET=change-me-generate-a-random-cron-secret

# Ustaw true wyłącznie za zaufanym reverse proxy nadpisującym nagłówki klienta.
TRUST_PROXY=false
