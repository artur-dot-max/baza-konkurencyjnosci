// Prisma Schema — Baza Konkurencyjności Funduszu Sprawiedliwości

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  GUEST
  ORGANIZATION
  CONTRACTOR
  ADMIN
}

enum OrgMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  RESOLVED
  CANCELLED
  COMPLETED
}

enum OrderType {
  SUPPLIES     // Dostawy
  SERVICES     // Usługi
  CONSTRUCTION // Roboty budowlane
}

// ============================================
// MODELS
// ============================================

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  password        String
  name            String?
  role            UserRole     @default(ORGANIZATION)
  orgRole         OrgMemberRole? @default(OWNER)
  isActive        Boolean      @default(true)
  sessionVersion  Int          @default(0)
  totpSecret      String?
  totpEnabled     Boolean      @default(false)
  totpBackupCodes String[]     @default([])
  passwordResets  PasswordReset[]
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  auditLogs       AuditLog[]
  errorLogs       ErrorLog[]
  historyEntries  AnnouncementHistory[]
  sentMessages    AdminMessage[] @relation("AdminMessageSender")
  receivedMessages AdminMessageRecipient[]
  notifications   Notification[]
  offers          Offer[]
  sentInvitations OrganizationInvitation[] @relation("InviteSender")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  nip           String             @unique
  regon         String             @unique
  krs           String?
  address       String
  city          String
  postalCode    String
  voivodeship   String             // Województwo
  email         String
  phone         String
  status        OrganizationStatus @default(PENDING)
  users         User[]
  announcements Announcement[]
  invitations   OrganizationInvitation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([nip])
  @@index([status])
  @@map("organizations")
}

model Announcement {
  id               String             @id @default(cuid())
  procedureNumber  String             @unique  // Numer postępowania
  title            String
  orderType        OrderType
  description      String             @db.Text  // Opis przedmiotu zamówienia (HTML)
  conditions       String?            @db.Text  // Warunki udziału (HTML)
  submissionMethods String[]          @default([]) // Sposoby składania ofert
  eDeliveryAddress String?                     // Adres do e-Doręczeń
  contactPerson    String?
  contactEmail     String?
  contactPhone     String?
  publishedAt      DateTime?                    // Data publikacji
  bidsDeadline     DateTime?                    // Termin składania ofert
  status           AnnouncementStatus @default(DRAFT)
  cancellationReason String?          @db.Text  // Powód unieważnienia
  resolution       String?            @db.Text  // Treść rozstrzygnięcia (HTML)

  // Dane lokalizacji ogłoszenia
  voivodeship      String?                      // Województwo (kopiowane z organizacji lub ustawiane ręcznie)
  location         String?                      // Miejscowość realizacji
  executionTerm    String?                      // Termin realizacji zamówienia

  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])

  attachments      Attachment[]
  questions        Question[]
  criteria         EvaluationCriteria[]
  history          AnnouncementHistory[]
  result           ProcurementResult?
  offers           Offer[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([publishedAt])
  @@index([procedureNumber])
  @@map("announcements")
}

model Offer {
  id             String            @id @default(cuid())
  bidderName     String
  bidderEmail    String
  bidderNip      String?
  price          Decimal           @db.Decimal(12, 2)
  description    String?           @db.Text
  announcementId String
  announcement   Announcement      @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments    OfferAttachment[]
  submittedAt    DateTime          @default(now())

  @@index([announcementId])
  @@index([submittedAt])
  @@index([userId])
  @@index([bidderEmail])
  @@map("offers")
}

model OfferAttachment {
  id           String   @id @default(cuid())
  offerId      String
  offer        Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  filePath     String
  createdAt    DateTime @default(now())

  @@index([offerId])
  @@map("offer_attachments")
}

model Attachment {
  id             String       @id @default(cuid())
  fileName       String       @unique
  originalName   String
  mimeType       String
  fileSize       Int          // w bajtach
  filePath       String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@map("attachments")
}

model Question {
  id             String       @id @default(cuid())
  content        String       @db.Text
  authorName     String?      // Anonimowe lub jawne
  authorEmail    String?
  isPublic       Boolean      @default(true)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  answers        Answer[]
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  content    String   @db.Text
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@map("answers")
}

model EvaluationCriteria {
  id             String       @id @default(cuid())
  name           String
  weight         Float        // Waga procentowa (0-100)
  description    String?      @db.Text
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("evaluation_criteria")
}

model AnnouncementHistory {
  id             String       @id @default(cuid())
  action         String       // np. "Utworzono", "Opublikowano", "Zmieniono opis"
  details        String?      @db.Text
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@index([userId])
  @@map("announcement_history")
}

model ProcurementResult {
  id               String       @id @default(cuid())
  contractorName   String       // Wybrany wykonawca
  contractorNip    String?
  price            Decimal      @db.Decimal(12, 2)
  justification    String       @db.Text  // Uzasadnienie wyboru
  announcementId   String       @unique
  announcement     Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("procurement_results")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // Operacja
  entity    String   // Nazwa encji
  entityId  String?  // ID encji
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  excerpt     String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("news")
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

model EmailOutbox {
  id          String    @id @default(cuid())
  to          String
  subject     String
  text        String    @db.Text
  replyTo     String?
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([sentAt, availableAt])
  @@map("email_outbox")
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}

model ErrorLog {
  id         String   @id @default(cuid())
  message    String   @db.Text
  stack      String?  @db.Text
  path       String?
  method     String?
  statusCode Int      @default(500)
  details    String?  @db.Text
  ipAddress  String?
  userAgent  String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([statusCode])
  @@index([userId])
  @@map("error_logs")
}

model AdminMessage {
  id          String                  @id @default(cuid())
  subject     String
  body        String                  @db.Text
  senderId    String
  sender      User                    @relation("AdminMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipients  AdminMessageRecipient[]
  createdAt   DateTime                @default(now())

  @@index([senderId])
  @@index([createdAt])
  @@map("admin_messages")
}

model AdminMessageRecipient {
  id        String       @id @default(cuid())
  messageId String
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime     @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@map("admin_message_recipients")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgMemberRole @default(EDITOR)
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

model DeadlineReminder {
  id             String   @id @default(cuid())
  announcementId String
  kind           String
  sentAt         DateTime @default(now())

  @@unique([announcementId, kind])
  @@map("deadline_reminders")
}
